#!/bin/sh
# Lane PK-1a: terminate every process on this host whose working directory is
# inside one attempt's worktree, and nothing else.
#
# usage: kill-worktree-tree <worktree-path> [grace-seconds]
#
# The worktree path is only ever "$1" or a variable inside a quoted expansion:
# it is never interpolated into a command string, and no pid outside the
# selected set is ever signalled. No pkill, no killall.
#
# Output: the last stdout line is `killed=<count of pids that received TERM>`
# with exit 0; a host without a readable /proc prints `unavailable=no-proc`
# and exits 3; a usage error exits 2.
set -u

usage() {
  echo 'usage: kill-worktree-tree <worktree-path> [grace-seconds]' >&2
  exit 2
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
grace=${2:-5}
case $grace in
  ''|*[!0-9]*) usage ;;
esac

wt=$1
if [ ! -d "$wt" ]; then
  echo 'killed=0'
  exit 0
fi
wt=$(cd "$wt" && pwd -P) || { echo 'killed=0'; exit 0; }

# Non-Linux host: no per-process working directory to inspect.
if [ ! -r /proc/self/cwd ]; then
  echo 'unavailable=no-proc'
  exit 3
fi

self=$$
parent=${PPID:-0}

# Walk /proc, read each candidate's cwd, and select only the pids whose cwd
# equals the worktree or lives inside it. A sibling name that merely extends
# the path (`<worktree>x`) never matches the `"$wt"/*` pattern.
selected=''
count=0
for entry in /proc/[0-9]*; do
  [ -d "$entry" ] || continue
  pid=${entry#/proc/}
  [ "$pid" = "$self" ] && continue
  [ "$pid" = "$parent" ] && continue
  cwd=$(readlink "$entry/cwd" 2>/dev/null) || continue
  [ -n "$cwd" ] || continue
  case $cwd in
    "$wt"|"$wt"/*) ;;
    *) continue ;;
  esac
  kill -TERM "$pid" 2>/dev/null || continue
  selected="$selected $pid"
  count=$((count + 1))
done

# Poll until none of the selected pids answers, then KILL the survivors.
deadline=$(( $(date +%s) + grace ))
while :; do
  alive=0
  for pid in $selected; do
    kill -0 "$pid" 2>/dev/null && alive=1
  done
  [ "$alive" -eq 0 ] && break
  [ "$(date +%s)" -ge "$deadline" ] && break
  sleep 0.2 2>/dev/null || sleep 1
done
for pid in $selected; do
  kill -KILL "$pid" 2>/dev/null
done

echo "killed=$count"
exit 0
