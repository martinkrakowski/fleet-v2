#!/bin/sh
# ocm-run — headless `opencode run` against an opencode server, and the
# three questions an orchestrator has about a lane: is one running, wait for it, stop it.
#
#   ocm-run --dir <path ON server> --agent lane [-m <model>] [--format json] "<prompt>"
#   ocm-run --status --dir <path>   # exit 0: nothing runs there; 3: a session is running (ids printed)
#   ocm-run --wait   --dir <path>   # 0: nothing runs there (read twice); 75: GAVE UP after OCM_WAIT_MAX,
#                                   #    a session still runs; 1: the status could not be read
#   ocm-run --abort  --dir <path>   # stops every session running there; 0 once nothing runs
#   ocm-run --check                 # exit 0 iff the dispatch path works. Runs nothing, opens no forward.
#   ocm-run --help | -h             # print usage and exit 0
#
# THE SESSION LIVES ON THE SERVER, NOT IN THIS PROCESS.
#   1. A dispatch is REFUSED (exit 75) when a session is already running in --dir.
#      OCM_ALLOW_BUSY=1 overrides it, for the rare case that is intended.
#   2. When this process is told to stop (INT, TERM, HUP), it ABORTS the session it
#      started before it exits. --detach switches that off: the lane then outlives
#      this process on purpose, and --wait / --abort are how it is followed.
#      On a v2 server --detach returns at once: it creates the session, launches
#      opencode disowned in its own process session, polls /api/session/active until
#      that id is listed or OCM_START_MAX seconds (default 60) pass, prints
#      "session started: <id> (detached)" and exits 0; a budget overrun aborts the
#      session and exits 1. A signal between the create and the launch aborts the
#      created id in the trap; after the launch a signal leaves the lane running.
#      On a v1 server --detach stays as above: it only disables the abort-on-signal
#      trap and still waits for the lane to end.
#   3. "Has the lane ended" is --status or --wait, never the end of a local process.
#      --wait says "nothing runs" only after TWO status reads in a row, OCM_WAIT_CONFIRM seconds
#      apart, both answered by the server and both listing nothing; a read that fails ends it with 1.
#
# Env: OCM_REMOTE_PORT (required; there is no default any more, a missing one is a usage error),
#      OCM_HOST (ssh host/alias when the tunnel is not already listening; empty or unset means the
#      local host, dialled directly at the remote port with no tunnel). The dial port is the remote
#      port for a local host and remote + 1 for an ssh host, so 65535 with OCM_HOST set has no room
#      for the forward. An OCM_PORT that differs from the dial port is refused.
#      OCM_ALLOW_BUSY=1; OCM_WAIT_INTERVAL (seconds between looks, default 15);
#      OCM_WAIT_MAX (seconds before --wait gives up with 75, default 1500);
#      OCM_WAIT_CONFIRM (seconds before the second read that confirms "nothing runs", default 5);
#      OCM_START_MAX (seconds --detach waits for the session to become visible, default 60);
#      OCM_RETRY_SLEEP (seconds before the single "database is locked" retry, default 20;
#      --detach counts it inside OCM_START_MAX and requires a non-negative whole number).
#      OPENCODE_SERVER_USERNAME (default opencode) and OPENCODE_SERVER_PASSWORD (or
#      OPENCODE_AUTH_FILE, default ~/.config/opencode/server-auth.env) for v2 basic auth.
# Server calls used:
#   v2 (opencode 2.x): GET /api/info (probe), GET /api/session/active, GET /api/session/<id>,
#                      POST /api/session/<id>/interrupt, POST /api/session (--dir; --detach
#                      local --dir too).
#   v1 (opencode 1.18): GET /session/status?directory=…, POST /session/<id>/abort?directory=….
# Exit: the run's own status; 1 the tunnel, the server or its session status could not be used or
# read, opencode is not on PATH, or a session still runs after --abort; 2 usage;
# 3 (--status) a session is running; 75 refused, or --wait gave up while a session still runs;
# 129/130/143 when stopped by HUP/INT/TERM.

set -u

for arg do
  case "$arg" in
    --help | -h)
      cat <<'EOF'
Usage: ocm-run [--status|--wait|--abort|--check|--detach] --dir <path> [--agent <agent>] [-m <model>] [--variant <variant>] [--format json] ["<prompt>"]
EOF
      exit 0
      ;;
  esac
done

if [ -z "${OPENCODE_SERVER_PASSWORD:-}" ] && [ -r "${OPENCODE_AUTH_FILE:-$HOME/.config/opencode/server-auth.env}" ]; then
  . "${OPENCODE_AUTH_FILE:-$HOME/.config/opencode/server-auth.env}"
fi
if [ -n "${OPENCODE_SERVER_PASSWORD:-}" ]; then
  OPENCODE_SERVER_USERNAME="${OPENCODE_SERVER_USERNAME:-opencode}"
  OPENCODE_PASSWORD="$OPENCODE_SERVER_PASSWORD"
  export OPENCODE_SERVER_USERNAME OPENCODE_SERVER_PASSWORD OPENCODE_PASSWORD
fi

if [ -z "${OCM_REMOTE_PORT:-}" ]; then
  echo "ocm-run: OCM_REMOTE_PORT is not set; there is no default port. Set it to the port the opencode server listens on (a local host is dialled there directly, an ssh host at that port + 1)." >&2
  exit 2
fi
remote=$OCM_REMOTE_PORT
case "$remote" in
  '' | *[!0-9]* | 0?* | ??????*)
    echo "ocm-run: OCM_REMOTE_PORT=$remote is not a port number (1 to 65535)" >&2
    exit 2
    ;;
esac
if [ "$remote" -lt 1 ] || [ "$remote" -gt 65535 ]; then
  echo "ocm-run: OCM_REMOTE_PORT=$remote is not a port number (1 to 65535)" >&2
  exit 2
fi
host="${OCM_HOST:-}"
if [ -n "$host" ]; then
  case "$host" in
    -*)
      echo "ocm-run: OCM_HOST=$host starts with '-': it would be read as an ssh option" >&2
      exit 2
      ;;
  esac
  if [ "$remote" -eq 65535 ]; then
    echo "ocm-run: OCM_REMOTE_PORT=65535 with OCM_HOST set leaves no room for the forward on $((remote + 1)); use a port below 65535" >&2
    exit 2
  fi
  port=$((remote + 1))
else
  port=$remote
fi
if [ -n "${OCM_PORT:-}" ] && [ "$OCM_PORT" != "$port" ]; then
  echo "ocm-run: OCM_PORT=$OCM_PORT does not match the dial port $port for OCM_REMOTE_PORT=$remote${host:+ on $host}; unset OCM_PORT" >&2
  exit 2
fi
url="http://127.0.0.1:$port"

# curl --config is line-based: a CR or LF in a credential would end the quoted value and start a
# new directive (Grok review of L3). Refuse such credentials before any request; name the
# variable, never its value.
case "${OPENCODE_SERVER_USERNAME:-}${OPENCODE_SERVER_PASSWORD:-}" in
  *"$(printf '\r')"* | *"
"*)
    echo "ocm-run: OPENCODE_SERVER_USERNAME or OPENCODE_SERVER_PASSWORD contains a line break; refusing" >&2
    exit 2
    ;;
esac

# True when the process listening on exactly 127.0.0.1:$port is ssh forwarding
# 127.0.0.1:$port:127.0.0.1:$remote to $host (Grok re-review of L3):
# - lsof -Fpn pairs each p<pid> with its n<address> lines; only a pid with an n line equal to
#   127.0.0.1:$port counts (a listener on [::1] or another address never vouches for it);
# - the process's own name (ps -o comm=, the executable, not argv) must be ssh, so a binary that
#   merely puts "ssh" in its argv does not pass;
# - argv must carry the exact forward -L 127.0.0.1:$port:127.0.0.1:$remote and end with $host.
ocm_port_held_by_our_forward() {
  command -v lsof >/dev/null 2>&1 || return 1
  pids=$(LC_ALL=C lsof -nP -iTCP:"$port" -sTCP:LISTEN -Fpn 2>/dev/null | awk -v want="127.0.0.1:$port" '
    /^p/ { pid = substr($0, 2); next }
    /^n/ { if (substr($0, 2) == want && pid != "") print pid }')
  for p in $pids; do
    c=$(LC_ALL=C ps -o comm= -p "$p" 2>/dev/null) || continue
    case "${c##*/}" in ssh) ;; *) continue ;; esac
    a=$(LC_ALL=C ps -ww -o args= -p "$p" 2>/dev/null) || continue
    # The exact forward, followed by a space (so remote 1234 never matches 12345)...
    case "$a" in *" -L 127.0.0.1:$port:127.0.0.1:$remote "*) ;; *) continue ;; esac
    # ...and $host as a whole word: at the end of argv, or followed by more arguments.
    case "$a" in *" $host" | *" $host "*) return 0 ;; esac
  done
  return 1
}

ocm_quote_config() { # $1 -> escaped for a curl --config quoted value
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

ocm_curl() {
  if [ -n "${OPENCODE_SERVER_PASSWORD:-}" ]; then
    {
      printf 'user = "%s:%s"\n' "$(ocm_quote_config "${OPENCODE_SERVER_USERNAME:-opencode}")" "$(ocm_quote_config "$OPENCODE_SERVER_PASSWORD")"
    } | curl --config - "$@"
  else
    curl "$@"
  fi
}

# Our own flags are taken out; for v2 servers --dir and --variant are rewritten before launch.
mode=run
detach=0
dir=''
variant=''
has_variant=0
model=''
has_model=0
has_session=0
prev=''
for arg do
  shift
  case "$arg" in
    --attach | --attach=* | --server | --server=*)
      echo "ocm-run: do not pass ${arg%%=*}; ocm-run connects to $url itself" >&2
      exit 2
      ;;
    --status | --wait | --abort | --check)
      [ "$mode" = run ] || { echo "ocm-run: one of --status, --wait, --abort, --check at a time" >&2; exit 2; }
      mode=${arg#--}
      prev=''
      continue
      ;;
    --detach)
      detach=1
      prev=''
      continue
      ;;
    --dir=*) dir=${arg#--dir=} ;;
    --variant=*)
      has_variant=1
      variant=${arg#--variant=}
      ;;
    --variant)
      has_variant=1
      ;;
    --model=*)
      has_model=1
      model=${arg#--model=}
      ;;
    -m | --model)
      has_model=1
      ;;
    -s | --session | --session=* | -c | --continue)
      has_session=1
      ;;
  esac
  case "$prev" in
    --dir) dir=$arg ;;
    --variant) variant=$arg ;;
    -m | --model) model=$arg ;;
  esac
  case "$prev" in
    --dir | --variant | -m | --model) prev='' ;;
    *) prev=$arg ;;
  esac
  set -- "$@" "$arg"
done

if [ "$has_variant" = 1 ]; then
  [ -n "$variant" ] || { echo "ocm-run: --variant needs a value" >&2; exit 2; }
  [ "$has_model" = 1 ] && [ -n "$model" ] || { echo "ocm-run: --variant requires -m <provider/model>" >&2; exit 2; }
  case "$model" in
    *'#'*)
      echo "ocm-run: cannot combine --variant $variant with an already hashed model ($model)" >&2
      exit 2
      ;;
  esac
fi

if ! nc -z 127.0.0.1 "$port" 2>/dev/null; then
  if [ "$mode" = check ]; then
    if [ -n "$host" ]; then
      echo "ocm-run: --check: nothing is listening on the dial port 127.0.0.1:$port (OCM_REMOTE_PORT=$remote on $host); --check opens no forward, a real dispatch would" >&2
    else
      echo "ocm-run: --check: nothing is listening on the dial port 127.0.0.1:$port (OCM_REMOTE_PORT=$remote) and OCM_HOST is not set; start the server on this host, a real dispatch opens no forward and exits 2" >&2
    fi
    exit 1
  fi
  if [ -z "$host" ]; then
    echo "ocm-run: server not listening on 127.0.0.1:$port and OCM_HOST is not set" >&2
    exit 2
  fi
  ssh -f -N -o ExitOnForwardFailure=yes -o BatchMode=yes \
    -L "127.0.0.1:$port:127.0.0.1:$remote" "$host" || {
    # A simultaneous dispatch's forward may have landed between the check and ours. Accept the port
    # only when its holder is an ssh forward of this port to $host (Grok review of L3): any other
    # listener would receive the session POST and the server credentials.
    if nc -z 127.0.0.1 "$port" 2>/dev/null && ocm_port_held_by_our_forward; then
      :
    else
      echo "ocm-run: could not open the tunnel to $host" >&2
      exit 1
    fi
  }
fi

# --check only: say who holds the dial port, and refuse when the holder is an ssh
# forward to some other host (2026-10-18: a stale forward to the old host looked ok).
if [ "$mode" = check ]; then
  lsof_out=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -Fpn 2>/dev/null)
  hpids=''
  cur_pid=''
  old_ifs=${IFS- 	
}
  set -f
  IFS='
'
  for line in $lsof_out; do
    case "$line" in
      p*)
        cur_pid=${line#p}
        ;;
      n*)
        addr=${line#n}
        addr=${addr%:*}
        case "$addr" in
          127.0.0.1 | localhost | '*' | '[::1]' | '[::]')
            if [ -n "$cur_pid" ]; then
              case " $hpids " in
                *" $cur_pid "*) ;;
                *) hpids="${hpids:+$hpids }$cur_pid" ;;
              esac
            fi
            ;;
        esac
        ;;
    esac
  done
  IFS=$old_ifs
  set +f
  if [ -z "$hpids" ]; then
    echo "ocm-run: --check: 127.0.0.1:$port is listening; its holder is unknown (lsof found no owner it may read), so its destination was NOT checked against OCM_HOST" >&2
  else
    norm_host=$host
    case "$norm_host" in
      ssh://*)
        norm_host=${norm_host#ssh://}
        norm_host=${norm_host#*@}
        norm_host=${norm_host%:*}
        ;;
      *)
        norm_host=${norm_host#*@}
        ;;
    esac
    bad_holder=0
    for hpid in $hpids; do
      from_proc=0
      hargs=''
      cmdline_file="${OCM_PROC_ROOT:-/proc}/$hpid/cmdline"
      if [ -r "$cmdline_file" ]; then
        hargs=$(tr '\0' '\n' < "$cmdline_file" 2>/dev/null)
      fi
      if [ -n "$hargs" ]; then
        from_proc=1
        hcmd=$(printf '%s' "$hargs" | tr '\n' ' ')
        hcmd=${hcmd% }
      else
        hcmd=$(ps -ww -o command= -p "$hpid" 2>/dev/null)
      fi
      echo "ocm-run: --check: 127.0.0.1:$port is held by pid $hpid: $hcmd" >&2
      if [ -n "$host" ] && [ -n "$hcmd" ]; then
        set -f
        first=''
        dest=''
        skip=0
        if [ "$from_proc" = 1 ]; then
          IFS='
'
          hwords=$hargs
        else
          hwords=$hcmd
        fi
        for w in $hwords; do
          if [ -z "$first" ]; then
            first=${w##*/}
            [ "$first" = ssh ] || break
            continue
          fi
          if [ "$skip" = 1 ]; then
            skip=0
            continue
          fi
          case "$w" in
            -[BbcDEeFIiJLlmOopQRSWw])
              skip=1
              ;;
            -[BbcDEeFIiJLlmOopQRSWw]* | -*)
              ;;
            *)
              dest=$w
              break
              ;;
          esac
        done
        IFS=$old_ifs
        set +f
        if [ "$first" = ssh ] && [ -n "$dest" ]; then
          case "$dest" in
            ssh://*)
              dest=${dest#ssh://}
              dest=${dest#*@}
              dest=${dest%:*}
              ;;
            *)
              dest=${dest#*@}
              ;;
          esac
          if [ "$dest" != "$norm_host" ]; then
            if [ "$from_proc" = 0 ]; then
              case "$hcmd" in
                *ProxyCommand* | *RemoteCommand* | *"'"* | *'"'*)
                  echo "ocm-run: --check: could not parse pid $hpid's ssh arguments reliably ('$dest' vs OCM_HOST='$host'); check it by hand" >&2
                  ;;
                *)
                  echo "ocm-run: --check: the forward on 127.0.0.1:$port goes to '$dest', not OCM_HOST='$host'; close it (kill $hpid) and run again" >&2
                  bad_holder=1
                  ;;
              esac
            else
              echo "ocm-run: --check: the forward on 127.0.0.1:$port goes to '$dest', not OCM_HOST='$host'; close it (kill $hpid) and run again" >&2
              bad_holder=1
            fi
          fi
        fi
      fi
    done
    [ "$bad_holder" = 1 ] && exit 1
  fi
fi

probe=$(ocm_curl -s -m 5 -w '\n%{http_code}:%{content_type}' "$url/api/info") || {
  echo "ocm-run: could not reach opencode server at $url (remote port $remote${host:+ on $host})" >&2
  exit 1
}
meta=$(printf '%s\n' "$probe" | tail -n 1)
code=${meta%%:*}
ctype=$(printf '%s' "${meta#*:}" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')
info_flat=$(printf '%s\n' "$probe" | sed '$d' | tr -d ' \n\r\t')

api=''
case "$code:$ctype:$info_flat" in
  200:application/json*:'{'*'}')
    api=v2
    ;;
  200:application/json*:*)
    echo "ocm-run: opencode server at $url (remote port $remote${host:+ on $host}) answered /api/info with non-object JSON" >&2
    exit 1
    ;;
  200:* | 404:*)
    api=v1
    ;;
  *)
    echo "ocm-run: opencode server at $url (remote port $remote${host:+ on $host}) answered HTTP $code on /api/info; is that opencode server running?" >&2
    exit 1
    ;;
esac

if [ "$mode" = check ]; then
  if [ "$api" = v1 ]; then
    v1_probe=$(ocm_curl -s -m 5 -G -w '\n%{http_code}:%{content_type}' "$url/session/status" --data-urlencode "directory=${dir:-/}") || v1_probe=''
    v1_meta=$(printf '%s\n' "$v1_probe" | tail -n 1)
    v1_code=${v1_meta%%:*}
    v1_ctype=$(printf '%s' "${v1_meta#*:}" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')
    v1_flat=$(printf '%s\n' "$v1_probe" | sed '$d' | tr -d ' \n\r\t')
    case "$v1_code:$v1_ctype:$v1_flat" in
      200:*text/html*:* )
        echo "ocm-run: opencode server at $url (remote port $remote${host:+ on $host}) answered HTML 200 on /api/info and /session/status" >&2
        exit 1
        ;;
      200:*:'{'*'}')
        ;;
      *)
        echo "ocm-run: opencode server at $url (remote port $remote${host:+ on $host}) did not answer v2 /api/info or v1 /session/status (HTTP ${v1_code:-000})" >&2
        exit 1
        ;;
    esac
  fi
  command -v opencode >/dev/null 2>&1 || {
    echo "ocm-run: opencode is not on PATH" >&2
    exit 1
  }
  echo "ocm-run: ok ($url${host:+ via $host}, remote port $remote)"
  exit 0
fi

# Prints the ids of the sessions running in $dir, one a line; nothing when none.
# Returns 1 when the server could not be asked: a caller must not read that as "none".
ocm_running() {
  if [ "$api" = v2 ]; then
    ocm_resp=$(ocm_curl -s -m 8 -w '\n%{http_code}:%{content_type}' "$url/api/session/active") || return 1
    ocm_meta=$(printf '%s\n' "$ocm_resp" | tail -n 1)
    ocm_code=${ocm_meta%%:*}
    ocm_ct=$(printf '%s' "${ocm_meta#*:}" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')
    case "$ocm_code:$ocm_ct" in 200:application/json*) ;; *) return 1 ;; esac
    ocm_flat=$(printf '%s\n' "$ocm_resp" | sed '$d' | tr -d ' \n\r\t')
    case "$ocm_flat" in
      '{"data":{}}' | '{"data":[]}' | '[]') return 0 ;;
      '{"data":{'*'}}' | '{"data":['*']}' | '['*']') ;;
      *) return 1 ;;
    esac
    ocm_all=$(printf '%s' "$ocm_flat" | grep -o '"ses_[^"]*"' | tr -d '"')
    [ -n "$ocm_all" ] || return 1
    ocm_want=$dir
    while [ "$ocm_want" != "/" ] && [ "${ocm_want%/}" != "$ocm_want" ]; do ocm_want=${ocm_want%/}; done
    ocm_nl='
'
    ocm_seen=''
    for ocm_id in $ocm_all; do
      case " $ocm_seen " in *" $ocm_id "*) continue ;; esac
      ocm_seen="$ocm_seen $ocm_id"
      ocm_chunk=$(printf '%s\n' "$ocm_flat" | sed "s/\"ses_/\\${ocm_nl}\"ses_/g" | grep "^\"$ocm_id\"")
      ocm_sdir=$(printf '%s\n' "$ocm_chunk" | sed -n 's/.*"location":{"directory":"\([^"]*\)".*/\1/p')
      if [ -z "$ocm_sdir" ]; then
        case "$ocm_chunk" in "\"$ocm_id\":{"*) ;; *) return 1 ;; esac
        ocm_sresp=$(ocm_curl -s -m 8 -w '\n%{http_code}:%{content_type}' "$url/api/session/$ocm_id") || return 1
        ocm_smeta=$(printf '%s\n' "$ocm_sresp" | tail -n 1)
        ocm_scode=${ocm_smeta%%:*}
        ocm_sct=$(printf '%s' "${ocm_smeta#*:}" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')
        case "$ocm_scode:$ocm_sct" in 200:application/json*) ;; *) return 1 ;; esac
        ocm_sflat=$(printf '%s\n' "$ocm_sresp" | sed '$d' | tr -d ' \n\r\t')
        ocm_sdir=$(printf '%s\n' "$ocm_sflat" | sed -n 's/.*"location":{"directory":"\([^"]*\)".*/\1/p')
      fi
      [ -n "$ocm_sdir" ] || return 1
      while [ "$ocm_sdir" != "/" ] && [ "${ocm_sdir%/}" != "$ocm_sdir" ]; do ocm_sdir=${ocm_sdir%/}; done
      [ "$ocm_sdir" = "$ocm_want" ] && echo "$ocm_id"
    done
    return 0
  fi
  # v1: -f so an HTTP error is a failure, whatever its body (the server's error bodies are JSON objects too)
  ocm_body=$(ocm_curl -sf -m 8 -G "$url/session/status" --data-urlencode "directory=$dir") || return 1
  case "$ocm_body" in '{'*) ;; *) return 1 ;; esac
  # Every session listed counts as running unless it is exactly {"type":"idle"}: a state this
  # script does not know (retry, with other keys before "type") must never read as "nothing".
  ocm_flat=$(printf '%s' "$ocm_body" | tr -d ' \n\t')
  ocm_all=$(printf '%s' "$ocm_flat" | grep -o '"ses_[^"]*":{' | sed 's/^"\([^"]*\)".*/\1/')
  ocm_idle=$(printf '%s' "$ocm_flat" | grep -o '"ses_[^"]*":{"type":"idle"}' | sed 's/^"\([^"]*\)".*/\1/')
  for ocm_id in $ocm_all; do
    case "
$ocm_idle
" in *"
$ocm_id
"*) ;; *) echo "$ocm_id" ;; esac
  done
  return 0
}

ocm_abort() { # $1: a session id
  if [ "$api" = v2 ]; then
    ocm_curl -s -o /dev/null -m 8 -X POST "$url/api/session/$1/interrupt"
  else
    ocm_curl -s -o /dev/null -m 8 -X POST -G "$url/session/$1/abort" --data-urlencode "directory=$dir"
  fi
}

if [ "$mode" != run ]; then
  [ -n "$dir" ] || { echo "ocm-run: --$mode needs --dir <path on the server>" >&2; exit 2; }
  ids=$(ocm_running) || { echo "ocm-run: could not read the session status from $url" >&2; exit 1; }
  case "$mode" in
    status)
      [ -z "$ids" ] && { echo "ocm-run: nothing is running in $dir (server: remote port $remote)"; exit 0; }
      echo "ocm-run: running in $dir:"
      echo "$ids"
      exit 3
      ;;
    wait)
      waited=0
      max=${OCM_WAIT_MAX:-1500}
      every=${OCM_WAIT_INTERVAL:-15}
      confirm=${OCM_WAIT_CONFIRM:-5}
      for ocm_n in "$max" "$every" "$confirm"; do
        case "$ocm_n" in '' | *[!0-9]* | 0?* | ??????*) echo "ocm-run: OCM_WAIT_MAX (0 to 99999), OCM_WAIT_INTERVAL and OCM_WAIT_CONFIRM (1 to 99999) must be whole seconds" >&2; exit 2 ;; esac
      done
      if [ "$every" -lt 1 ] || [ "$confirm" -lt 1 ]; then
        echo "ocm-run: OCM_WAIT_INTERVAL and OCM_WAIT_CONFIRM must be at least 1 second" >&2
        exit 2
      fi
      idle=0
      while :; do
        if [ -z "$ids" ]; then
          idle=$((idle + 1))
          if [ "$idle" -ge 2 ]; then
            echo "ocm-run: nothing is running in $dir (server: remote port $remote; read twice; waited $waited s)"
            exit 0
          fi
          pause=$confirm
        else
          idle=0
          if [ "$waited" -ge "$max" ]; then
            echo "ocm-run: WAIT GAVE UP (exit 75), the lane has NOT ended: still running in $dir after $waited s: $(echo "$ids" | tr '\n' ' ')" >&2
            exit 75
          fi
          pause=$every
        fi
        sleep "$pause"
        waited=$((waited + pause))
        ids=$(ocm_running) || { echo "ocm-run: WAIT STOPPED (exit 1), the lane may still run: could not read the session status from $url" >&2; exit 1; }
      done
      ;;
    abort)
      [ -z "$ids" ] && { echo "ocm-run: nothing is running in $dir"; exit 0; }
      for id in $ids; do
        ocm_abort "$id"
        echo "ocm-run: asked the server to abort $id" >&2
      done
      tries=0
      while [ "$tries" -lt 10 ]; do
        ids=$(ocm_running) || { echo "ocm-run: could not read the session status from $url" >&2; exit 1; }
        [ -z "$ids" ] && { echo "ocm-run: nothing is running in $dir"; exit 0; }
        sleep 1
        tries=$((tries + 1))
      done
      echo "ocm-run: still running in $dir after the abort: $(echo "$ids" | tr '\n' ' ')" >&2
      exit 1
      ;;
  esac
fi

# Without --dir neither rule can work, and the old fault would be back without a word.
[ -n "$dir" ] || { echo "ocm-run: a run needs --dir <path on the server>; without it nothing can be refused or aborted" >&2; exit 2; }

# Rule 1: never a second session in a directory where one is running.
before=$(ocm_running) || { echo "ocm-run: could not read the session status from $url; not dispatching blind" >&2; exit 1; }
if [ -n "$before" ] && [ "${OCM_ALLOW_BUSY:-0}" != 1 ]; then
  echo "ocm-run: a session is already running in $dir: $(echo "$before" | tr '\n' ' ')" >&2
  echo "ocm-run: not dispatching a second one. Wait for it (ocm-run --wait --dir …) or stop it (ocm-run --abort --dir …)." >&2
  exit 75
fi

errf=$(mktemp "${TMPDIR:-/tmp}/ocm-run.XXXXXX") || exit 1
child=''
ocm_sid=''
ocm_launched=0
ocm_cpid=''
ocm_sid_caller=0

# Rule 2: told to stop, this process stops what it started on the server.
ocm_stop() { # $1: exit status
  trap '' INT TERM HUP
  ocm_dog=''
  if [ -n "$child" ]; then
    kill "$child" 2>/dev/null
    ( sleep 10; kill -9 "$child" 2>/dev/null ) > /dev/null 2>&1 &
    ocm_dog=$!
  fi
  if [ "$detach" = 0 ] && [ -n "$dir" ]; then
    now=$(ocm_running) || {
      now=''
      echo "ocm-run: stopped, but the session status could not be read: a session may still run in $dir (ocm-run --status --dir …)" >&2
    }
    for id in $now; do
      case "
$before
" in *"
$id
"*) continue ;; esac
      ocm_abort "$id"
      echo "ocm-run: stopped; asked the server to abort $id" >&2
    done
  elif [ "$detach" = 1 ]; then
    # A signal that lands during the create POST leaves the answer in ocm_sresp with no
    # id taken from it yet: take the id from the answer before deciding what to abort.
    if [ -z "$ocm_sid" ] && [ -n "${ocm_sresp:-}" ]; then
      ocm_sid=$(ocm_sid_from_resp "$ocm_sresp")
      ocm_sid_ok "$ocm_sid" || ocm_sid=''
    fi
    if [ -n "$ocm_sid" ] && ocm_sid_ok "$ocm_sid" && [ "$ocm_launched" != 1 ] && [ "$has_session" = 0 ]; then
      ocm_abort "$ocm_sid"
      echo "ocm-run: stopped; aborted the session $ocm_sid before it was launched" >&2
    else
      echo "ocm-run: stopped; --detach was given, the session runs on in $dir" >&2
    fi
  fi
  if [ -n "$child" ]; then
    wait "$child" 2>/dev/null
    kill "$ocm_dog" 2>/dev/null
  fi
  cat "$errf" >&2
  rm -f "$errf"
  exit "$1"
}
trap 'rm -f "$errf"' EXIT
trap 'ocm_stop 130' INT
trap 'ocm_stop 143' TERM
trap 'ocm_stop 129' HUP

if [ "$api" = v2 ]; then
  case "$model:$variant" in
    nvidia/*:low) variant=none ;;
  esac
  skip=''
  fold=''
  for arg do
    shift
    if [ -n "$skip" ]; then
      skip=''
      continue
    fi
    if [ -n "$fold" ]; then
      fold=''
      set -- "$@" "$arg#$variant"
      continue
    fi
    case "$arg" in
      --dir | --variant)
        skip=1
        continue
        ;;
      --dir=* | --variant=*)
        continue
        ;;
      -m | --model)
        if [ "$has_variant" = 1 ]; then
          fold=1
        fi
        set -- "$@" "-m"
        continue
        ;;
      --model=*)
        if [ "$has_variant" = 1 ]; then
          set -- "$@" "-m" "${arg#--model=}#$variant"
        else
          set -- "$@" "-m" "${arg#--model=}"
        fi
        continue
        ;;
    esac
    set -- "$@" "$arg"
  done
fi

# The run is a background child so that a signal reaches the traps at once; a shell
# only runs a trap after its foreground command has ended.
ocm_launch() {
  if [ "$api" = v2 ]; then
    if [ -d "$dir" ]; then
      ( cd "$dir" && exec opencode run --server "$url" "$@" ) < /dev/null 2> "$errf" &
    else
      ocm_create_session "$@"
      [ "$rc" = 0 ] || return
      if [ "$has_session" = 1 ]; then
        opencode run --server "$url" "$@" < /dev/null 2> "$errf" &
      else
        opencode run --server "$url" -s "$ocm_sid" "$@" < /dev/null 2> "$errf" &
      fi
    fi
  else
    opencode run --attach "$url" "$@" < /dev/null 2> "$errf" &
  fi
  child=$!
  wait "$child"
  rc=$?
  child=''
}

# The session id inside a POST /api/session answer ('' when there is none).
ocm_sid_from_resp() {
  printf '%s' "$1" | LC_ALL=C grep -o '"id":"ses_[^"]*"' | head -n 1 | LC_ALL=C sed 's/"id":"//;s/"//'
}

# 0 when $1 is a session id ocm-run will use in paths: "ses_" followed only by letters,
# digits, '_' and '-'; 1 otherwise.
ocm_sid_ok() {
  case "$1" in
    ses_*) ;;
    *) return 1 ;;
  esac
  case "${1#ses_}" in
    '' | *[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# v2: make sure a session exists for this dispatch and set ocm_sid to it. With -s <id>
# (or --session <id>) given by the caller, that id is ocm_sid and no session is created;
# otherwise POST /api/session and take the id from the answer (a failed create, or an
# answer with no id, is exit 1).
ocm_create_session() {
  ocm_sid=''
  ocm_sresp=''
  if [ "$has_session" = 1 ]; then
    # Only -s <id>, --session <id> and --session=<id> carry a caller id;
    # -c/--continue does not (opencode continues the latest session itself).
    prev=''
    ocm_bare=0
    for a in "$@"; do
      case "$a" in
        -s | --session) ocm_bare=1 ;;
      esac
      case "$prev" in
        -s | --session) ocm_sid=$a; break ;;
      esac
      case "$a" in
        --session=*) ocm_sid=${a#--session=}; break ;;
      esac
      prev=$a
    done
    if [ -n "$ocm_sid" ]; then
      ocm_sid_ok "$ocm_sid" || {
        echo "ocm-run: refusing session id $ocm_sid" >&2
        ocm_sid=''
        rc=2
        return
      }
      rc=0
      return
    fi
    if [ "$ocm_bare" = 1 ]; then
      echo "ocm-run: -s was given without a session id" >&2
      rc=2
      return
    fi
    if [ "$detach" = 1 ]; then
      echo "ocm-run: --detach needs a session id: pass -s <id> or none" >&2
      rc=2
      return
    fi
    rc=0
    return
  fi
  case "$dir" in
    *'"'* | *'\'*)
      echo "ocm-run: refusing --dir with quote or backslash" >&2
      rc=2
      return
      ;;
  esac
  ocm_sresp=$(ocm_curl -sf -m 8 -H 'Content-Type: application/json' -d "{\"location\":{\"directory\":\"$dir\"}}" "$url/api/session") || {
    echo "ocm-run: could not create a session on the server for $dir (POST $url/api/session)" >&2
    rc=1
    return
  }
  ocm_sid=$(ocm_sid_from_resp "$ocm_sresp")
  [ -n "$ocm_sid" ] || {
    echo "ocm-run: the server answered the session create but gave no session id" >&2
    rc=1
    return
  }
  ocm_sid_ok "$ocm_sid" || {
    # A server id ocm-run would not use in a path is not trusted: abort nothing.
    ocm_sid=''
    echo "ocm-run: the server answered with a session id ocm-run refuses to use" >&2
    rc=1
    return
  }
  rc=0
}

# Launch opencode disowned in its own process session (setsid when available, else nohup
# plus &), stdin /dev/null, stdout and stderr to $ocm_log. The lane keeps running after
# this process exits; ocm_launched marks that handoff.
ocm_launch_detached() {
  if [ -d "$dir" ]; then
    if command -v setsid >/dev/null 2>&1; then
      ( cd "$dir" && exec setsid opencode "$@" ) < /dev/null > "$ocm_log" 2>&1 &
    else
      ( cd "$dir" && exec nohup opencode "$@" ) < /dev/null > "$ocm_log" 2>&1 &
    fi
  else
    if command -v setsid >/dev/null 2>&1; then
      setsid opencode "$@" < /dev/null > "$ocm_log" 2>&1 &
    else
      nohup opencode "$@" < /dev/null > "$ocm_log" 2>&1 &
    fi
  fi
  ocm_cpid=$!
  ocm_launched=1
  rc=0
}

# --detach on a v2 server: create the session (or take the resumed one), launch opencode
# disowned, and return at once; ocm_detach_run polls for the session. The detached log
# is <dir>/.lane/ocm-run.<id>.log when <dir> exists locally (.lane is created if missing),
# otherwise a file under ${TMPDIR:-/tmp}.
ocm_detach_launch() {
  ocm_create_session "$@"
  [ "$rc" = 0 ] || return
  ocm_sid_caller=$has_session
  if [ -d "$dir" ]; then
    ocm_logdir="$dir/.lane"
    mkdir -p "$ocm_logdir" 2>/dev/null || {
      echo "ocm-run: could not create $ocm_logdir for the detached log" >&2
      rc=1
      return
    }
    ocm_log="$ocm_logdir/ocm-run.$ocm_sid.log"
  else
    # An unpredictable name: the id alone must not let another process guess the file.
    ocm_log=$(mktemp "${TMPDIR:-/tmp}/ocm-run.$ocm_sid.XXXXXX") || {
      echo "ocm-run: could not create the detached log file under ${TMPDIR:-/tmp}" >&2
      rc=1
      return
    }
  fi
  if [ "$has_session" = 1 ]; then
    ocm_launch_detached run --server "$url" "$@"
  else
    ocm_launch_detached run --server "$url" -s "$ocm_sid" "$@"
  fi
}

# Any failure after the session was created but before "session started" is printed must
# leave nothing behind: stop the client (if one was launched; TERM, then KILL after a
# bounded wait) and abort the id — unless it is the caller's own -s id.
# The client stop is its own helper so the "database is locked" retry can also kill the
# first client before it relaunches: it must never abort the session itself.
ocm_detach_kill_client() {
  if [ -n "$ocm_cpid" ]; then
    kill "$ocm_cpid" 2>/dev/null
    ( sleep 5; kill -9 "$ocm_cpid" 2>/dev/null ) > /dev/null 2>&1 &
    ocm_dog=$!
    wait "$ocm_cpid" 2>/dev/null
    kill "$ocm_dog" 2>/dev/null
    ocm_cpid=''
  fi
}

ocm_detach_cleanup() {
  ocm_detach_kill_client
  if [ -n "$ocm_sid" ] && [ "$ocm_sid_caller" != 1 ]; then
    ocm_abort "$ocm_sid"
    echo "ocm-run: aborted the session $ocm_sid" >&2
  fi
}

# --detach poll: wait until the session is listed in /api/session/active, or OCM_START_MAX
# seconds run out (then abort it and exit 1). While waiting, a "database is locked" log
# entry relaunches once (the OCM_RETRY_SLEEP retry).
ocm_detach_run() {
  max=${OCM_START_MAX:-60}
  case "$max" in
    '' | *[!0-9]* | 0?* | ??????*) echo "ocm-run: OCM_START_MAX must be a whole number of seconds (0 to 99999)" >&2; exit 2 ;;
  esac
  ocm_retried=0
  retry_sleep=${OCM_RETRY_SLEEP:-20}
  case "$retry_sleep" in
    '' | *[!0-9]* | 0?* | ??????*) echo "ocm-run: OCM_RETRY_SLEEP must be a whole number of seconds (0 to 99999)" >&2; exit 2 ;;
  esac
  ocm_detach_launch "$@"
  [ "$rc" = 0 ] || { ocm_detach_cleanup; exit "$rc"; }
  while :; do
    # One unreadable status read is "not yet", not the end: keep polling until the
    # budget runs out; only the overrun aborts and exits 1.
    now=$(ocm_running) || now=''
    case "
$now
" in
      *"
$ocm_sid
"*)
        echo "session started: $ocm_sid (detached)"
        exit 0
        ;;
    esac
    if [ $(( $(date +%s) - start )) -ge "$max" ]; then
      echo "ocm-run: session $ocm_sid did not appear within $max s; aborting it" >&2
      ocm_detach_cleanup
      exit 1
    fi
    if [ "$ocm_retried" = 0 ] && LC_ALL=C grep -q "database is locked" "$ocm_log" 2>/dev/null; then
      if [ $(( $(date +%s) - start + retry_sleep )) -ge "$max" ]; then
        echo "ocm-run: the retry would not fit in the $max s budget: session $ocm_sid did not appear within $max s; aborting it" >&2
        ocm_detach_cleanup
        exit 1
      fi
      echo "ocm-run: opencode database was locked at launch; retrying once in $retry_sleep s" >&2
      sleep "$retry_sleep" &
      wait "$!"
      ocm_retried=1
      # Stop the first client before the relaunch overwrites ocm_cpid: a client that
      # is still alive would otherwise be left running with no pid left to stop it.
      ocm_detach_kill_client
      # The retry reuses the SAME session id: do not create a second one, relaunch
      # the client with -s <same id>.
      if [ "$has_session" = 1 ]; then
        ocm_launch_detached run --server "$url" "$@"
      else
        ocm_launch_detached run --server "$url" -s "$ocm_sid" "$@"
      fi
      continue
    fi
    sleep 1
  done
}

start=$(date +%s)
if [ "$api" = v2 ] && [ "$detach" = 1 ]; then
  ocm_detach_run "$@"
fi
ocm_launch "$@"
if [ "$rc" -ne 0 ] && [ $(( $(date +%s) - start )) -lt 10 ] && grep -q "database is locked" "$errf"; then
  cat "$errf" >&2
  echo "ocm-run: opencode database was locked at launch; retrying once in 20 s" >&2
  sleep "${OCM_RETRY_SLEEP:-20}" &
  wait "$!"
  ocm_launch "$@"
fi
cat "$errf" >&2
exit "$rc"
