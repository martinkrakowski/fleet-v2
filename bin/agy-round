#!/bin/sh
# agy-round — one command per step of an Argon (agy) fix round, run from the orchestrator's
# machine (macOS and Linux, POSIX sh). Today the orchestrator types four long ssh/scp/git
# commands per round; this script makes each step one command. Sibling of bin/agy-run: the
# lane runs in the container, this script drives it from outside.
#
# Subcommands:
#   agy-round prepare --name <n> --branch <b> --brief <local file> [--from <local git dir>]
#                   (pushes refs/heads/<b> of --from to the clone; never HEAD; exit 2 when <b> is not a local branch there)
#   agy-round run --name <n> --model <m> --brief <.lane/x.md> [--timeout <45m>] [--log <file>]
#   agy-round commit --name <n> --message-file <local file> -- <path>...
#                   (relative paths of letters, digits, the at sign and . _ / + - [ ]; brackets
#                   admit Next.js dynamic routes and are passed to git literally)
#   agy-round fetch --name <n> --branch <b> [--into <local git dir>]
#   agy-round --help
#
# Environment (no defaults; a missing or empty one is a usage error, exit 2):
#   AGY_ROUND_SSH           ssh destination of the lane container.
#   AGY_ROUND_ROOT          absolute directory inside the container under which each lane's clone
#                           lives ($AGY_ROUND_ROOT/<name>).
#   AGY_ROUND_GUARD_SSH     ssh destination of the host that checks the container's pinned hashes.
#   AGY_ROUND_GUARD_CMD     the single command run there (as one ssh argument) that prints the hash
#                           check; its exit status is the verdict (0 clean).
#   AGY_ROUND_SETTLE        optional seconds to wait after the last ssh before the "after" hash
#                           check, default 20.
#
# Exit codes: 0 ok, 1 failure, 2 usage, 75 refused.
# The orchestrator runs the project's gate on the fetched branch before pushing it anywhere. This
# script pushes only to the operator-configured AGY_ROUND_SSH/AGY_ROUND_ROOT clone; it has no forge
# step of its own, and pointing those variables at a forge is an operator error it cannot detect.

set -u
# Byte-wise pattern ranges: under a UTF-8 locale some shells (bash 3.2, macOS /bin/sh)
# let `a-z` match upper-case letters, so every `case` range below assumes the C locale.
LC_ALL=C
export LC_ALL

usage() {
  cat <<'USAGE'
Usage: agy-round <subcommand> [options]
Subcommands:
  prepare --name <n> --branch <b> --brief <local file> [--from <local git dir>]
           (pushes refs/heads/<b> of --from, never HEAD)
  run --name <n> --model <m> --brief <.lane/x.md> [--timeout <45m>] [--log <file>]
  commit --name <n> --message-file <local file> -- <path>...
  fetch --name <n> --branch <b> [--into <local git dir>]
Environment (no defaults; a missing one is a usage error, exit 2):
  AGY_ROUND_SSH=<container>        ssh destination of the lane container
  AGY_ROUND_ROOT=<root>            absolute path inside <container> for lane clones
  AGY_ROUND_GUARD_SSH=<guard-host> ssh destination of the guard host
  AGY_ROUND_GUARD_CMD=<command>    guard command run on <guard-host>
  AGY_ROUND_SETTLE=<seconds>       optional settle delay before post-run guard (default 20)
USAGE
}

die_usage() { echo "agy-round: $1" >&2; usage >&2; exit 2; }

nl='
'
cr=$(printf '\r')
at=$(printf '\100')

reject_nl() { # $1: label, $2: value
  case "$2" in
    *"$nl"* | *"$cr"* | *[[:cntrl:]]*)
      die_usage "$1 must not contain a newline or carriage return"
      ;;
  esac
}

# shq: single-quote one argument for the remote shell (' becomes '\'').
shq() {
  reject_nl "remote argument" "$1"
  case "$1" in
    *\'*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf "'%s'" "$1" ;;
  esac
}

require_env() { # names, one per remaining argument
  while [ "$#" -gt 0 ]; do
    v=$1; shift
    eval "val=\${$v:-}"
    [ -n "$val" ] || die_usage "environment variable $v is required"
    reject_nl "$v" "$val"
  done
}

validate_root() {
  reject_nl "AGY_ROUND_ROOT" "$AGY_ROUND_ROOT"
  case "$AGY_ROUND_ROOT" in
    /*) ;;
    *) die_usage "AGY_ROUND_ROOT must be an absolute path" ;;
  esac
  case "$AGY_ROUND_ROOT" in
    *[!A-Za-z0-9._/-]*)
      die_usage "AGY_ROUND_ROOT contains invalid characters"
      ;;
  esac
}

validate_name() {
  reject_nl "--name" "$1"
  case "$1" in
    '' | *..* | *[!a-z0-9._-]* | [!a-z0-9]*)
      die_usage "invalid --name '$1': lowercase letter or digit first, then letters/digits/._- , at most 64"
      ;;
  esac
  [ "${#1}" -le 64 ] || die_usage "invalid --name '$1': longer than 64 characters"
}

validate_branch() {
  reject_nl "--branch" "$1"
  [ -n "$1" ] || die_usage "--branch is required"
  git check-ref-format --branch "$1" >/dev/null 2>&1 || die_usage "invalid branch '$1'"
}

validate_brief() {
  reject_nl "--brief" "$1"
  case "$1" in
    .lane/?*) ;;
    *) die_usage "--brief must be a relative path under .lane/" ;;
  esac
  case "$1" in
    *..* | *[[:space:]]*) die_usage "--brief must contain no .. and no whitespace" ;;
  esac
}

validate_filename() { # $1: label, $2: filename
  reject_nl "$1" "$2"
  case "$2" in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*)
      die_usage "invalid $1 '$2'"
      ;;
  esac
}

validate_model() {
  reject_nl "--model" "$1"
  case "$1" in
    '' | [!A-Za-z0-9]* | *[!A-Za-z0-9._:/-]*)
      die_usage "invalid --model '$1'"
      ;;
  esac
}

validate_timeout() {
  reject_nl "--timeout" "$1"
  t_digits=${1%[smh]}
  case "$t_digits" in
    '' | *[!0-9]*)
      die_usage "invalid --timeout '$1'"
      ;;
  esac
}

validate_settle() {
  if [ -n "${AGY_ROUND_SETTLE+x}" ]; then
    reject_nl "AGY_ROUND_SETTLE" "$AGY_ROUND_SETTLE"
    case "$AGY_ROUND_SETTLE" in
      '' | *[!0-9]*)
        die_usage "invalid AGY_ROUND_SETTLE '$AGY_ROUND_SETTLE'"
        ;;
    esac
  fi
}

fail_prepare() { # $1: dir, $2: message
  ssh -o BatchMode=yes "$AGY_ROUND_SSH" "rm -rf -- $(shq "$1")"
  echo "agy-round: $2" >&2
  exit 1
}

cmd=${1:-}
case "$cmd" in
  '') die_usage "missing subcommand" ;;
  --help | -h) usage; exit 0 ;;
esac
shift

case "$cmd" in
  prepare)
    name=''; branch=''; brief=''; from='.'
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) [ "$#" -ge 2 ] || die_usage "--name needs a value"; name=$2; shift ;;
        --name=*) name=${1#--name=} ;;
        --branch) [ "$#" -ge 2 ] || die_usage "--branch needs a value"; branch=$2; shift ;;
        --branch=*) branch=${1#--branch=} ;;
        --brief) [ "$#" -ge 2 ] || die_usage "--brief needs a value"; brief=$2; shift ;;
        --brief=*) brief=${1#--brief=} ;;
        --from) [ "$#" -ge 2 ] || die_usage "--from needs a value"; from=$2; shift ;;
        --from=*) from=${1#--from=} ;;
        -*) die_usage "unknown option $1" ;;
        *) die_usage "unexpected argument $1" ;;
      esac
      shift
    done
    validate_name "$name"
    validate_branch "$branch"
    [ -n "$brief" ] || die_usage "--brief is required"
    reject_nl "--brief" "$brief"
    case "$brief" in
      */) die_usage "invalid --brief '$brief'" ;;
    esac
    base=$(basename "$brief")
    validate_filename "brief basename" "$base"
    [ -f "$brief" ] || die_usage "--brief '$brief' must be an existing regular file"
    # Push exactly the named branch of --from, never its HEAD: with another branch checked out
    # there, HEAD would seed the container with the wrong commit.
    git -C "$from" rev-parse --verify --quiet "refs/heads/$branch^{commit}" >/dev/null 2>&1 \
      || die_usage "branch '$branch' does not exist in --from '$from' (prepare pushes refs/heads/$branch, never HEAD)"
    require_env AGY_ROUND_SSH AGY_ROUND_ROOT
    validate_root
    dir="$AGY_ROUND_ROOT/$name"
    # Refuse when the lane's clone already exists in the container.
    if ssh -o BatchMode=yes "$AGY_ROUND_SSH" "test -e $(shq "$dir")"; then
      echo "agy-round: $dir already exists in the container" >&2
      exit 75
    fi
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git init -q $(shq "$dir") && git -C $(shq "$dir") symbolic-ref HEAD refs/heads/agy-round-unborn" \
      || fail_prepare "$dir" "git init failed in the container"
    GIT_SSH_COMMAND='ssh -o BatchMode=yes' git -C "$from" -c core.hooksPath=/dev/null push -q "$AGY_ROUND_SSH:$dir" "refs/heads/$branch:refs/heads/$branch" \
      || fail_prepare "$dir" "push to the container failed"
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") -c core.hooksPath=/dev/null checkout -q $(shq "$branch")" \
      || fail_prepare "$dir" "checkout in the container failed"
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "mkdir -p $(shq "$dir/.lane")" \
      || fail_prepare "$dir" "mkdir .lane in the container failed"
    scp -q -o BatchMode=yes "$brief" "$AGY_ROUND_SSH:$dir/.lane/$base" \
      || fail_prepare "$dir" "scp brief failed"
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") check-ignore -q $(shq ".lane/$base")"
    ci_rc=$?
    if [ "$ci_rc" -eq 1 ]; then
      fail_prepare "$dir" "brief path is not gitignored"
    elif [ "$ci_rc" -ne 0 ]; then
      fail_prepare "$dir" "could not check the brief path"
    fi
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") log --oneline -1" \
      || fail_prepare "$dir" "git log in the container failed"
    echo ".lane/$base"
    ;;
  run)
    name=''; model=''; brief=''; timeout=45m; log=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) [ "$#" -ge 2 ] || die_usage "--name needs a value"; name=$2; shift ;;
        --name=*) name=${1#--name=} ;;
        --model) [ "$#" -ge 2 ] || die_usage "--model needs a value"; model=$2; shift ;;
        --model=*) model=${1#--model=} ;;
        --brief) [ "$#" -ge 2 ] || die_usage "--brief needs a value"; brief=$2; shift ;;
        --brief=*) brief=${1#--brief=} ;;
        --timeout) [ "$#" -ge 2 ] || die_usage "--timeout needs a value"; timeout=$2; shift ;;
        --timeout=*) timeout=${1#--timeout=} ;;
        --log) [ "$#" -ge 2 ] || die_usage "--log needs a value"; log=$2; shift ;;
        --log=*) log=${1#--log=} ;;
        -*) die_usage "unknown option $1" ;;
        *) die_usage "unexpected argument $1" ;;
      esac
      shift
    done
    [ -n "$model" ] || die_usage "--model is required"
    validate_name "$name"
    validate_model "$model"
    validate_timeout "$timeout"
    validate_brief "$brief"
    require_env AGY_ROUND_SSH AGY_ROUND_ROOT AGY_ROUND_GUARD_SSH AGY_ROUND_GUARD_CMD
    validate_root
    validate_settle
    dir="$AGY_ROUND_ROOT/$name"
    # Guard check BEFORE: refuse to start agy when the container is not clean.
    if ! ssh -o BatchMode=yes "$AGY_ROUND_GUARD_SSH" "$AGY_ROUND_GUARD_CMD"; then
      echo "agy-round: hash check failed before the run" >&2
      exit 1
    fi
    cmd="agy-run --dir $(shq "$dir") --model $(shq "$model") --mode full --isolation-declared --sandbox --timeout $(shq "$timeout") --brief $(shq "$brief")"
    if [ -n "$log" ]; then
      ssh -o BatchMode=yes "$AGY_ROUND_SSH" "$cmd" > "$log"
      rc=$?
    else
      ssh -o BatchMode=yes "$AGY_ROUND_SSH" "$cmd"
      rc=$?
    fi
    if ! sleep "${AGY_ROUND_SETTLE:-20}"; then
      echo "agy-round: settle wait failed" >&2
      exit 1
    fi
    # Guard check AFTER.
    if ! ssh -o BatchMode=yes "$AGY_ROUND_GUARD_SSH" "$AGY_ROUND_GUARD_CMD"; then
      echo "agy-round: hash check failed after the run" >&2
      exit 1
    fi
    changes=$(ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") status --porcelain")
    status_rc=$?
    if [ "$status_rc" -ne 0 ]; then
      echo "agy-round: could not read the clone's status" >&2
      [ "$rc" -eq 0 ] || exit "$rc"
      exit 1
    fi
    echo '--- git status --porcelain ---'
    [ -z "$changes" ] || echo "$changes"
    echo '--- git diff --stat ---'
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") diff --stat"
    [ "$rc" -eq 0 ] || exit "$rc"
    if [ -n "$changes" ]; then
      exit 0
    fi
    echo "agy-round: no edits" >&2
    exit 1
    ;;
  commit)
    name=''; msg=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) [ "$#" -ge 2 ] || die_usage "--name needs a value"; name=$2; shift ;;
        --name=*) name=${1#--name=} ;;
        --message-file) [ "$#" -ge 2 ] || die_usage "--message-file needs a value"; msg=$2; shift ;;
        --message-file=*) msg=${1#--message-file=} ;;
        --) shift; break ;;
        -*) die_usage "unknown option $1" ;;
        *) die_usage "unexpected argument $1" ;;
      esac
      shift
    done
    [ "$#" -ge 1 ] || die_usage "commit requires at least one path"
    validate_name "$name"
    [ -n "$msg" ] || die_usage "--message-file is required"
    reject_nl "--message-file" "$msg"
    [ -f "$msg" ] || die_usage "--message-file '$msg' must be an existing regular file"
    quoted_paths=''
    while [ "$#" -gt 0 ]; do
      raw_p=$1; shift
      reject_nl "commit path" "$raw_p"
      # Allowed characters: letters, digits, and . _ / + - [ ] (plus the at
      # sign), the brackets admitting Next.js App Router dynamic routes like
      # projects/[id]/page.tsx. git receives these paths later as literal
      # pathspecs (--literal-pathspecs) so the brackets are never read as glob
      # metacharacters.
      case "$raw_p" in
        '' | /*) die_usage "invalid path '$raw_p': must be a relative path" ;;
        *[!]A-Za-z0-9._/$at+[-]*) die_usage "invalid path '$raw_p': contains forbidden characters" ;;
      esac
      p=$raw_p
      while :; do
        case "$p" in
          ./*) p=${p#./} ;;
          *) break ;;
        esac
      done
      case "$p" in
        '' | /*) die_usage "invalid path '$raw_p': must be a non-empty relative path" ;;
      esac
      case "/$p/" in
        */../*) die_usage "invalid path '$raw_p': must not contain .." ;;
        */.lane/* | */.git/*) die_usage "refusing protected path '$raw_p'" ;;
      esac
      quoted_paths="$quoted_paths $(shq "$p")"
    done
    require_env AGY_ROUND_SSH AGY_ROUND_ROOT
    validate_root
    dir="$AGY_ROUND_ROOT/$name"
    add_cmd="git --literal-pathspecs -C $(shq "$dir") add --$quoted_paths"
    msg_base='agy-round-msg.txt'
    validate_filename "message temp name" "$msg_base"
    tmp="$dir/.lane/$msg_base"
    scp -q -o BatchMode=yes "$msg" "$AGY_ROUND_SSH:$tmp" \
      || { echo "agy-round: scp message failed" >&2; exit 1; }
    if ! ssh -o BatchMode=yes "$AGY_ROUND_SSH" "$add_cmd"; then
      ssh -o BatchMode=yes "$AGY_ROUND_SSH" "rm -f $(shq "$tmp")"
      echo "agy-round: git add in the container failed" >&2
      exit 1
    fi
    if ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") diff --cached --quiet"; then
      ssh -o BatchMode=yes "$AGY_ROUND_SSH" "rm -f $(shq "$tmp")"
      echo "agy-round: nothing was staged" >&2
      exit 1
    fi
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") -c core.hooksPath=/dev/null commit -q -F $(shq "$tmp")" \
      || { ssh -o BatchMode=yes "$AGY_ROUND_SSH" "rm -f $(shq "$tmp")"; echo "agy-round: commit in the container failed" >&2; exit 1; }
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "rm -f $(shq "$tmp")"
    ssh -o BatchMode=yes "$AGY_ROUND_SSH" "git -C $(shq "$dir") log --oneline -1" \
      || { echo "agy-round: git log in the container failed" >&2; exit 1; }
    ;;
  fetch)
    name=''; branch=''; into='.'
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --name) [ "$#" -ge 2 ] || die_usage "--name needs a value"; name=$2; shift ;;
        --name=*) name=${1#--name=} ;;
        --branch) [ "$#" -ge 2 ] || die_usage "--branch needs a value"; branch=$2; shift ;;
        --branch=*) branch=${1#--branch=} ;;
        --into) [ "$#" -ge 2 ] || die_usage "--into needs a value"; into=$2; shift ;;
        --into=*) into=${1#--into=} ;;
        -*) die_usage "unknown option $1" ;;
        *) die_usage "unexpected argument $1" ;;
      esac
      shift
    done
    validate_name "$name"
    validate_branch "$branch"
    require_env AGY_ROUND_SSH AGY_ROUND_ROOT
    validate_root
    dir="$AGY_ROUND_ROOT/$name"
    # The -argon ref is this script's own: the fetch is forced (+).
    GIT_SSH_COMMAND='ssh -o BatchMode=yes' git -C "$into" -c core.hooksPath=/dev/null fetch -q "$AGY_ROUND_SSH:$dir" "+$branch:refs/heads/$branch-argon" \
      || { echo "agy-round: fetch failed" >&2; exit 1; }
    git -C "$into" log --oneline -1 "$branch-argon" \
      || { echo "agy-round: no ref $branch-argon" >&2; exit 1; }
    ;;
  *) die_usage "unknown subcommand $cmd" ;;
esac
