# Copy this file to deploy/staging/staging.env and fill in this installation's values.
# deploy/staging/staging.env is ignored by git; this example is tracked.
# Every value is required and none has a default. A value already set in the
# environment wins over the one written here. Each value takes letters, digits
# and . _ : / - only.

# Registry and path that holds the fleet-v2 image.
STAGING_REGISTRY=registry.example.invalid/library

# Docker context the image is built and pushed on.
STAGING_DOCKER_CONTEXT=docker.example.invalid

# ssh target of the cluster node the manifests are applied on.
STAGING_SSH=node.example.invalid

# Ingress hostname of the staging deployment.
STAGING_HOST=fleet-v2.example.invalid

# cert-manager ClusterIssuer that issues the ingress certificate.
STAGING_CLUSTER_ISSUER=staging-ca
