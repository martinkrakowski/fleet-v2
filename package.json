{
  "name": "fleet",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:bin": "sh scripts/test-bin.sh",
    "clean": "turbo clean",
    "sync": "hexagen sync",
    "sync:dry": "hexagen sync --dry-run",
    "sync:check": "hexagen sync --check --allow-dirty",
    "lint:arch": "hexagen arch validate",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\""
  },
  "devDependencies": {
    "@hexagen-monaco/arch-linter": "0.15.0",
    "@hexagen-monaco/sync": "0.15.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.11.5",
    "typescript": "^5.5.4"
  },
  "resolutions": {
    "cli-truncate@npm:^6.0.0": "6.1.1",
    "es-toolkit@npm:^1.52.0": "1.52.0"
  }
}
