{
  "name": "fleet",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:bin": "for t in tests/*.test.sh; do sh \"$t\" || exit 1; done",
    "clean": "turbo clean",
    "sync": "hexagen sync",
    "sync:dry": "hexagen sync --dry-run",
    "sync:check": "hexagen sync --check --allow-dirty",
    "lint:arch": "hexagen arch validate",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\"",
    "staging:deploy": "sh deploy/staging/deploy.sh"
  },
  "devDependencies": {
    "@hexagen-monaco/arch-linter": "0.14.0",
    "@hexagen-monaco/sync": "0.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.11.5",
    "typescript": "^5.5.4"
  }
}
